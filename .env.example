SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-random-characters
LRCLIB_USER_AGENT=SonicDisplay/0.1.0 (https://your-domain.example)

# Last.fm API key (server-side only; request at https://www.last.fm/api/account/create)
LASTFM_API_KEY=your_lastfm_api_key

# Optional Genius developer access token (server-side only)
GENIUS_ACCESS_TOKEN=your_genius_access_token

# V71: admin and Vercel Blob
SONIC_ADMIN_PASSWORD=
SONIC_ADMIN_SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=

# V365 real Web Push (opt-in; all are server-side secrets except public VAPID key)
# Upstash Redis REST database (persistent, not in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
PUSH_ENCRYPTION_KEY=
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Use a distinct random secret; Vercel automatically passes it to cron as Bearer.
CRON_SECRET=

# Optional artist / track / album enrichment (server-side only)
# MusicBrainz requires no key; <=1 request/second and identified User-Agent.
MUSICBRAINZ_ENABLED=true
# TheAudioDB free v1 key 123; replace with your supporter key if available.
THEAUDIODB_API_KEY=123
THEAUDIODB_ENABLED=true
# https://www.flickr.com/services/apps/create/ (non-commercial or approved use)
FLICKR_API_KEY=
STAGE_FLICKR_ENABLED=true
# TheAudioDB fan-art licensing varies: only include its images in the gallery when explicitly opted in.
STAGE_THEAUDIODB_PHOTOS_ENABLED=false

# V967 Alexa virtual-concert integration (Vercel; keep secret server-side)
# Generate a unique random secret of at least 32 chars and copy same value to AWS Lambda.
ALEXA_BRIDGE_SECRET=
# Uses existing UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN above.
# AWS Lambda-only environment variables (not for Next.js or browser):
# ALEXA_SKILL_ID=amzn1.ask.skill.YOUR-SKILL-ID
# ALEXA_ALLOWED_USER_ID=amzn1.ask.account.YOUR-ALEXA-USER-ID
# SONIC_DISPLAY_ORIGIN=https://your-production-domain.example
# ALEXA_BRIDGE_SECRET=(same secret as Vercel)

# V970: no additional secrets required.
# Physical Govee look commands remain opt-in in the browser; they re-use
# existing ALEXA_BRIDGE_SECRET and the Govee LAN Bridge token stored locally.

# V982 optional AI concert director (Responses API; server-side only).
# No API key = user can still create local, rule-based scene suggestions.
# Configure on Vercel as an encrypted environment variable; never NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# V983: Song Intelligence uses the existing OPENAI_API_KEY and OPENAI_MODEL.
# Only explicit user consent sends title, artist, genre and track duration; no audio or lyrics.
